{
  "name": "timeline-story-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run migrate:data",
    "dev": "concurrently -k -n api,ui -c blue,green \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build",
    "prestart": "npm run migrate:data",
    "start": "tsx server/index.ts",
    "shortcut:icon": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/update-shortcut-icon.ps1",
    "install:windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/install-timeline.ps1",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "migrate:data": "tsx scripts/migrate-legacy-data.ts",
    "import:md": "tsx scripts/import-markdown.ts"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.1.10",
    "express": "^4.21.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.57.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
